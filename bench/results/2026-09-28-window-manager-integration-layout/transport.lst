0000DFr 1  8D ED F3             sta OUTLINE_GATEWAY_TAG
0000E2r 1  A2 00                ldx #$00
0000E4r 1               copy_page_gateway:
0000E4r 1  BD rr rr             lda page_gateway,x
0000E7r 1  9D 8A F6             sta COMMON_GATEWAY,x
0000EAr 1  E8                   inx
0000EBr 1  E0 44                cpx #page_gateway_end-page_gateway
0000EDr 1  D0 F5                bne copy_page_gateway
0000EFr 1  68                   pla
0000F0r 1  8D EE F3             sta COMMON_PAGE
0000F3r 1  20 8A F6             jsr COMMON_GATEWAY
0000F6r 1  60                   rts
0000F7r 1               
0000F7r 1               _udeks_vic_bitmap_outline_blit:
0000F7r 1  AD ED F3             lda OUTLINE_GATEWAY_TAG
0000FAr 1  C9 A5                cmp #$a5
0000FCr 1  F0 1D                beq run_outline_gateway
0000FEr 1  A2 00                ldx #$00
000100r 1               copy_outline_gateway_0:
000100r 1  BD rr rr             lda outline_gateway,x
000103r 1  9D 8A F6             sta COMMON_GATEWAY,x
000106r 1  E8                   inx
000107r 1  D0 F7                bne copy_outline_gateway_0
000109r 1  A2 00                ldx #$00
00010Br 1               copy_outline_gateway_1:
00010Br 1  BD rr rr             lda outline_gateway+$100,x
00010Er 1  9D 8A F7             sta COMMON_GATEWAY+$100,x
000111r 1  E8                   inx
000112r 1  E0 66                cpx #outline_gateway_end-outline_gateway-$100
000114r 1  D0 F5                bne copy_outline_gateway_1
000116r 1  A9 A5                lda #$a5
000118r 1  8D ED F3             sta OUTLINE_GATEWAY_TAG
00011Br 1               run_outline_gateway:
00011Br 1  20 8A F6             jsr COMMON_GATEWAY
00011Er 1  60                   rts
00011Fr 1               
00011Fr 1               vic_gateway:
00011Fr 1  A9 60                lda #>VIC_BITMAP
000121r 1  8D 9C F6             sta COMMON_GATEWAY+(clear_bitmap-vic_gateway)+2
000124r 1  A9 00                lda #$00
000126r 1  8D 04 FF             sta MMU_LCR_WORKER_FLAT
000129r 1  A2 20                ldx #$20
00012Br 1  A0 00                ldy #$00
00012Dr 1  A9 00                lda #$00
00012Fr 1               clear_bitmap:
00012Fr 1  99 00 60             sta VIC_BITMAP,y
000132r 1  C8                   iny
000133r 1  D0 FA                bne clear_bitmap
000135r 1  EE 9C F6             inc COMMON_GATEWAY+(clear_bitmap-vic_gateway)+2
000138r 1  CA                   dex
000139r 1  D0 F4                bne clear_bitmap
00013Br 1               
00013Br 1  A9 5C                lda #>VIC_SCREEN
00013Dr 1  8D B1 F6             sta COMMON_GATEWAY+(clear_screen-vic_gateway)+2
000140r 1  A2 04                ldx #$04
000142r 1  A9 07                lda #$07
000144r 1               clear_screen:
