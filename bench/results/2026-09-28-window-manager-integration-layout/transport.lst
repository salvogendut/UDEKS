00014Dr 1  CA                   dex
00014Er 1  D0 F4                bne clear_screen
000150r 1               
000150r 1  A2 3E                ldx #$3e
000152r 1               copy_sprite:
000152r 1  BD 49 F7             lda COMMON_GATEWAY+(sprite_data-vic_gateway),x
000155r 1  9D C0 7F             sta VIC_SPRITE,x
000158r 1  CA                   dex
000159r 1  10 F7                bpl copy_sprite
00015Br 1  A9 FF                lda #$ff
00015Dr 1  8D F8 5F             sta VIC_SPRITE_POINTER
000160r 1               
000160r 1  A9 00                lda #$00
000162r 1  8D 01 FF             sta MMU_LCR_KERNEL_IO
000165r 1               
000165r 1  08                   php
000166r 1  78                   sei
000167r 1  AD 06 D5             lda MMU_RCR
00016Ar 1                       ; Make the bank transition explicit and keep the complete VIC/MMU
00016Ar 1                       ; setup atomic with respect to the console's periodic IRQ work.
00016Ar 1  29 BF                and #$bf
00016Cr 1  8D 06 D5             sta MMU_RCR
00016Fr 1  09 40                ora #$40
000171r 1  8D 06 D5             sta MMU_RCR
000174r 1  AD 02 DD             lda CIA2_DDRA
000177r 1  09 03                ora #$03
000179r 1  8D 02 DD             sta CIA2_DDRA
00017Cr 1  AD 00 DD             lda CIA2_PRA
00017Fr 1  29 FC                and #$fc
000181r 1  09 02                ora #$02
000183r 1  8D 00 DD             sta CIA2_PRA
000186r 1               
000186r 1  A9 07                lda #$07
000188r 1  8D 20 D0             sta VIC_BORDER_COLOR
00018Br 1  8D 21 D0             sta VIC_BACKGROUND_COLOR
00018Er 1  A9 78                lda #$78
000190r 1  8D 18 D0             sta VIC_MEMORY
000193r 1  A9 08                lda #$08
000195r 1  8D 16 D0             sta VIC_CONTROL_2
000198r 1               
000198r 1  AD 10 D0             lda VIC_SPRITE_X_MSB
00019Br 1  29 FE                and #$fe
00019Dr 1  8D 10 D0             sta VIC_SPRITE_X_MSB
0001A0r 1  AD 1C D0             lda VIC_SPRITE_MULTICOLOR
0001A3r 1  29 FE                and #$fe
0001A5r 1  8D 1C D0             sta VIC_SPRITE_MULTICOLOR
0001A8r 1  AD 1B D0             lda VIC_SPRITE_PRIORITY
0001ABr 1  29 FE                and #$fe
0001ADr 1  8D 1B D0             sta VIC_SPRITE_PRIORITY
0001B0r 1  AD 1D D0             lda VIC_SPRITE_X_EXPAND
0001B3r 1  29 FE                and #$fe
0001B5r 1  8D 1D D0             sta VIC_SPRITE_X_EXPAND
0001B8r 1  AD 17 D0             lda VIC_SPRITE_Y_EXPAND
0001BBr 1  29 FE                and #$fe
0001BDr 1  8D 17 D0             sta VIC_SPRITE_Y_EXPAND
0001C0r 1  A9 AC                lda #$ac
0001C2r 1  8D 00 D0             sta VIC_SPRITE0_X
0001C5r 1  A9 8C                lda #$8c
0001C7r 1  8D 01 D0             sta VIC_SPRITE0_Y
0001CAr 1  A9 00                lda #$00
0001CCr 1  8D 27 D0             sta VIC_SPRITE0_COLOR
0001CFr 1  AD 15 D0             lda VIC_SPRITE_ENABLE
0001D2r 1  09 01                ora #$01
0001D4r 1  8D 15 D0             sta VIC_SPRITE_ENABLE
0001D7r 1  A9 3B                lda #$3b
0001D9r 1  8D 11 D0             sta VIC_CONTROL_1
0001DCr 1  28                   plp
0001DDr 1  60                   rts
