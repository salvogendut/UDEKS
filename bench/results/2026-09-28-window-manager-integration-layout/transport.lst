000317r 1  B9 8A F3             lda OUTLINE_BUFFER+10,y
00031Ar 1  8D A1 F7             sta COMMON_GATEWAY+(vertical_load-outline_gateway)+1
00031Dr 1  8D A7 F7             sta COMMON_GATEWAY+(vertical_store-outline_gateway)+1
000320r 1  B9 8B F3             lda OUTLINE_BUFFER+11,y
000323r 1  8D A2 F7             sta COMMON_GATEWAY+(vertical_load-outline_gateway)+2
000326r 1  8D A8 F7             sta COMMON_GATEWAY+(vertical_store-outline_gateway)+2
000329r 1  B9 8C F3             lda OUTLINE_BUFFER+12,y
00032Cr 1  8D EF F7             sta COMMON_GATEWAY+(vertical_mask-outline_gateway)
00032Fr 1  20 9B F7             jsr COMMON_GATEWAY+(draw_vertical-outline_gateway)
000332r 1               
