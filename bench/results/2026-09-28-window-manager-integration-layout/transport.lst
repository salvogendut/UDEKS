000002r 1                       .segment "CODE"
000000r 1               _udeks_vic_graphics_enable:
000000r 1                       ; Hide the VIC canvas while the common-RAM gateway changes its bank
000000r 1                       ; and prepares the new bitmap.  The gateway reveals bitmap mode only
000000r 1                       ; after the screen, bitmap, and pointer are all coherent.
000000r 1  AD 11 D0             lda VIC_CONTROL_1
000003r 1  29 EF                and #$ef
000005r 1  8D 11 D0             sta VIC_CONTROL_1
000008r 1                       ; On the C128, CPU port bit 2 controls the character-ROM overlay seen
000008r 1                       ; by the VIC-IIe in every 16 KiB VIC bank.  Our screen matrix is at
000008r 1                       ; VIC-relative $1C00, inside that overlay window, so expose RAM before
000008r 1                       ; the first bitmap badline and preserve the caller's prior setting.
000008r 1  A5 01                lda CPU_PORT
00000Ar 1  29 04                and #$04
00000Cr 1  8D rr rr             sta saved_chargen_overlay
00000Fr 1  A5 01                lda CPU_PORT
000011r 1  09 04                ora #$04
000013r 1  85 01                sta CPU_PORT
000015r 1  A9 00                lda #$00
000017r 1  8D C7 F1             sta VIC_STATUS_POINTER_SHAPE
00001Ar 1  8D ED F3             sta OUTLINE_GATEWAY_TAG
00001Dr 1  A2 00                ldx #$00
00001Fr 1               copy_gateway:
00001Fr 1  BD rr rr             lda vic_gateway,x
000022r 1  9D 8A F6             sta COMMON_GATEWAY,x
000025r 1  E8                   inx
000026r 1  E0 FE                cpx #vic_gateway_end-vic_gateway
000028r 1  D0 F5                bne copy_gateway
00002Ar 1  20 8A F6             jsr COMMON_GATEWAY
00002Dr 1  A9 00                lda #$00
00002Fr 1  60                   rts
000030r 1               
000030r 1               _udeks_vic_graphics_disable:
000030r 1  AD 15 D0             lda VIC_SPRITE_ENABLE
000033r 1  29 FE                and #$fe
000035r 1  8D 15 D0             sta VIC_SPRITE_ENABLE
000038r 1  AD 11 D0             lda VIC_CONTROL_1
00003Br 1  29 CF                and #$cf
00003Dr 1  8D 11 D0             sta VIC_CONTROL_1
000040r 1  AD 06 D5             lda MMU_RCR
000043r 1  29 BF                and #$bf
000045r 1  8D 06 D5             sta MMU_RCR
000048r 1  AD rr rr             lda saved_chargen_overlay
00004Br 1  F0 06                beq restore_chargen_overlay
00004Dr 1  A5 01                lda CPU_PORT
00004Fr 1  09 04                ora #$04
000051r 1  D0 04                bne store_chargen_overlay
000053r 1               restore_chargen_overlay:
000053r 1  A5 01                lda CPU_PORT
000055r 1  29 FB                and #$fb
000057r 1               store_chargen_overlay:
000057r 1  85 01                sta CPU_PORT
000059r 1  A9 00                lda #$00
00005Br 1  8D C7 F1             sta VIC_STATUS_POINTER_SHAPE
00005Er 1  60                   rts
00005Fr 1               
00005Fr 1               _udeks_vic_pointer_set_x:
00005Fr 1  8D 00 D0             sta VIC_SPRITE0_X
000062r 1  48                   pha
000063r 1  AD 10 D0             lda VIC_SPRITE_X_MSB
000066r 1  E0 00                cpx #$00
000068r 1  F0 04                beq pointer_x_low
00006Ar 1  09 01                ora #$01
00006Cr 1  D0 02                bne pointer_x_store
00006Er 1               pointer_x_low:
00006Er 1  29 FE                and #$fe
000070r 1               pointer_x_store:
000070r 1  8D 10 D0             sta VIC_SPRITE_X_MSB
000073r 1  68                   pla
000074r 1  60                   rts
000075r 1               
000075r 1               _udeks_vic_pointer_set_y:
000075r 1  8D 01 D0             sta VIC_SPRITE0_Y
000078r 1  60                   rts
000079r 1               
000079r 1               _udeks_vic_pointer_busy_begin:
000079r 1  AA                   tax
00007Ar 1  AD B5 F1             lda VIC_STATUS_STATE
00007Dr 1  C9 03                cmp #VIC_STATE_ACTIVE
00007Fr 1  D0 15                bne pointer_busy_done
000081r 1  AD C7 F1             lda VIC_STATUS_POINTER_SHAPE
000084r 1  F0 08                beq pointer_busy_install
000086r 1  C9 03                cmp #BUSY_RELEASE_PENDING
000088r 1  D0 0C                bne pointer_busy_done
00008Ar 1  8E C7 F1             stx VIC_STATUS_POINTER_SHAPE
00008Dr 1  60                   rts
00008Er 1               pointer_busy_install:
00008Er 1  8E C7 F1             stx VIC_STATUS_POINTER_SHAPE
000091r 1  A9 01                lda #$01
000093r 1  4C rr rr             jmp _udeks_vic_pointer_select_shape
000096r 1               pointer_busy_done:
000096r 1  60                   rts
000097r 1               
000097r 1               _udeks_vic_pointer_busy_end:
000097r 1  AA                   tax
000098r 1  EC C7 F1             cpx VIC_STATUS_POINTER_SHAPE
00009Br 1  D0 F9                bne pointer_busy_done
00009Dr 1  AD E2 F1             lda POINTER_FRAME_LOW
0000A0r 1  18                   clc
0000A1r 1  69 03                adc #BUSY_HOLD_FRAMES
0000A3r 1  8D rr rr             sta busy_release_frame
0000A6r 1  A9 03                lda #BUSY_RELEASE_PENDING
0000A8r 1  8D C7 F1             sta VIC_STATUS_POINTER_SHAPE
0000ABr 1  60                   rts
0000ACr 1               
0000ACr 1               _udeks_vic_pointer_busy_tick:
0000ACr 1  AD C7 F1             lda VIC_STATUS_POINTER_SHAPE
0000AFr 1  C9 03                cmp #BUSY_RELEASE_PENDING
0000B1r 1  D0 E3                bne pointer_busy_done
0000B3r 1  AD E2 F1             lda POINTER_FRAME_LOW
0000B6r 1  CD rr rr             cmp busy_release_frame
0000B9r 1  D0 DB                bne pointer_busy_done
0000BBr 1  A9 00                lda #$00
0000BDr 1  8D C7 F1             sta VIC_STATUS_POINTER_SHAPE
0000C0r 1  4C rr rr             jmp _udeks_vic_pointer_select_shape
0000C3r 1               
0000C3r 1               _udeks_vic_pointer_select_shape:
0000C3r 1  8D EE F3             sta COMMON_PAGE
0000C6r 1  A9 00                lda #$00
0000C8r 1  8D ED F3             sta OUTLINE_GATEWAY_TAG
0000CBr 1  A2 00                ldx #$00
0000CDr 1               copy_sprite_swap_gateway:
0000CDr 1  BD rr rr             lda sprite_swap_gateway,x
0000D0r 1  9D 8A F6             sta COMMON_GATEWAY,x
0000D3r 1  E8                   inx
0000D4r 1  E0 2E                cpx #sprite_swap_gateway_end-sprite_swap_gateway
0000D6r 1  D0 F5                bne copy_sprite_swap_gateway
0000D8r 1  20 8A F6             jsr COMMON_GATEWAY
0000DBr 1  60                   rts
0000DCr 1               
0000DCr 1               _udeks_vic_bitmap_commit_page:
0000DCr 1  48                   pha
