00035Fr 1  8D EC F7             sta COMMON_GATEWAY+(horizontal_mask-outline_gateway)
000362r 1  20 7C F7             jsr COMMON_GATEWAY+(horizontal_toggle-outline_gateway)
000365r 1  20 86 F7             jsr COMMON_GATEWAY+(horizontal_advance-outline_gateway)
000368r 1  CA                   dex
000369r 1               horizontal_middle:
000369r 1  E0 01                cpx #$01
00036Br 1  F0 0E                beq horizontal_final
00036Dr 1  A9 FF                lda #$ff
00036Fr 1  8D EC F7             sta COMMON_GATEWAY+(horizontal_mask-outline_gateway)
000372r 1  20 7C F7             jsr COMMON_GATEWAY+(horizontal_toggle-outline_gateway)
000375r 1  20 86 F7             jsr COMMON_GATEWAY+(horizontal_advance-outline_gateway)
000378r 1  CA                   dex
000379r 1  D0 EE                bne horizontal_middle
00037Br 1               horizontal_final:
00037Br 1  AD EB F7             lda COMMON_GATEWAY+(horizontal_last-outline_gateway)
00037Er 1  8D EC F7             sta COMMON_GATEWAY+(horizontal_mask-outline_gateway)
000381r 1               horizontal_toggle:
000381r 1               horizontal_load:
000381r 1  AD FF FF             lda $ffff
000384r 1  4D EC F7             eor COMMON_GATEWAY+(horizontal_mask-outline_gateway)
000387r 1               horizontal_store:
000387r 1  8D FF FF             sta $ffff
00038Ar 1  60                   rts
00038Br 1               
00038Br 1               horizontal_advance:
00038Br 1  18                   clc
00038Cr 1  AD 7D F7             lda COMMON_GATEWAY+(horizontal_load-outline_gateway)+1
00038Fr 1  69 08                adc #$08
000391r 1  8D 7D F7             sta COMMON_GATEWAY+(horizontal_load-outline_gateway)+1
000394r 1  8D 83 F7             sta COMMON_GATEWAY+(horizontal_store-outline_gateway)+1
000397r 1  90 06                bcc horizontal_advance_done
000399r 1  EE 7E F7             inc COMMON_GATEWAY+(horizontal_load-outline_gateway)+2
00039Cr 1  EE 84 F7             inc COMMON_GATEWAY+(horizontal_store-outline_gateway)+2
00039Fr 1               horizontal_advance_done:
