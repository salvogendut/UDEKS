000345r 1  8D 01 FF             sta MMU_LCR_KERNEL_IO
000348r 1  60                   rts
000349r 1               
000349r 1               draw_horizontal:
000349r 1  AE E9 F7             ldx COMMON_GATEWAY+(horizontal_count-outline_gateway)
00034Cr 1  E0 01                cpx #$01
00034Er 1  D0 0C                bne horizontal_multiple
000350r 1  AD EA F7             lda COMMON_GATEWAY+(horizontal_first-outline_gateway)
000353r 1  2D EB F7             and COMMON_GATEWAY+(horizontal_last-outline_gateway)
000356r 1  8D EC F7             sta COMMON_GATEWAY+(horizontal_mask-outline_gateway)
000359r 1  4C 7C F7             jmp COMMON_GATEWAY+(horizontal_toggle-outline_gateway)
