0003A0r 1               
0003A0r 1               draw_vertical:
0003A0r 1  AE ED F7             ldx COMMON_GATEWAY+(vertical_count-outline_gateway)
0003A3r 1  F0 46                beq vertical_done
0003A5r 1               vertical_next:
0003A5r 1               vertical_load:
0003A5r 1  AD FF FF             lda $ffff
0003A8r 1  4D EF F7             eor COMMON_GATEWAY+(vertical_mask-outline_gateway)
0003ABr 1               vertical_store:
