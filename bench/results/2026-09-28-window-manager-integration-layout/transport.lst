00024Br 1                       .assert sprite_swap_gateway_end-sprite_swap_gateway < $40, error, "VIC sprite swap gateway is too large"
00024Br 1               
00024Br 1               page_gateway:
00024Br 1  AD EE F3             lda COMMON_PAGE
00024Er 1  18                   clc
00024Fr 1  69 rr                adc #>_udeks_vic_bitmap_shadow
000251r 1  8D A0 F6             sta COMMON_GATEWAY+(page_load_shadow-page_gateway)+2
000254r 1  AD EE F3             lda COMMON_PAGE
000257r 1  18                   clc
000258r 1  69 60                adc #>VIC_BITMAP
00025Ar 1  8D BA F6             sta COMMON_GATEWAY+(page_store_bitmap-page_gateway)+2
00025Dr 1  A0 00                ldy #$00
00025Fr 1               page_stage:
00025Fr 1               page_load_shadow:
00025Fr 1  B9 rr rr             lda _udeks_vic_bitmap_shadow,y
000262r 1  99 00 F4             sta COMMON_BUFFER,y
000265r 1  C8                   iny
000266r 1  D0 F7                bne page_stage
000268r 1               
000268r 1  A9 00                lda #$00
00026Ar 1  8D 04 FF             sta MMU_LCR_WORKER_FLAT
00026Dr 1  A0 00                ldy #$00
00026Fr 1  AD EE F3             lda COMMON_PAGE
000272r 1  C9 1F                cmp #$1f
000274r 1  F0 0B                beq page_copy_last
000276r 1               page_copy_full:
000276r 1  B9 00 F4             lda COMMON_BUFFER,y
000279r 1               page_store_bitmap:
000279r 1  99 00 60             sta VIC_BITMAP,y
00027Cr 1  C8                   iny
00027Dr 1  D0 F7                bne page_copy_full
00027Fr 1  F0 0B                beq page_copy_done
000281r 1               page_copy_last:
000281r 1  B9 00 F4             lda COMMON_BUFFER,y
000284r 1  99 00 7F             sta VIC_BITMAP+$1f00,y
