000335r 1  18                   clc
000336r 1  69 0F                adc #$0f
000338r 1  8D E7 F7             sta COMMON_GATEWAY+(outline_record-outline_gateway)
00033Br 1  CE E8 F7             dec COMMON_GATEWAY+(outline_left-outline_gateway)
00033Er 1  F0 03                beq outline_done
000340r 1  4C 9D F6             jmp COMMON_GATEWAY+(outline_next-outline_gateway)
000343r 1               outline_done:
