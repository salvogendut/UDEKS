00021Dr 1               vic_gateway_end:
00021Dr 1                       .assert vic_gateway_end-vic_gateway < $100, error, "VIC common gateway exceeds one-page installer"
00021Dr 1               
00021Dr 1               sprite_swap_gateway:
00021Dr 1  A9 00                lda #$00
00021Fr 1  8D 04 FF             sta MMU_LCR_WORKER_FLAT
000222r 1  AD EE F3             lda COMMON_PAGE
000225r 1  F0 13                beq sprite_restore_normal
000227r 1  A2 3E                ldx #$3e
000229r 1               sprite_save_normal:
000229r 1  BD C0 7F             lda VIC_SPRITE,x
00022Cr 1  9D 00 41             sta VIC_SPRITE_NORMAL,x
00022Fr 1  BD 40 41             lda VIC_SPRITE_BUSY,x
000232r 1  9D C0 7F             sta VIC_SPRITE,x
000235r 1  CA                   dex
000236r 1  10 F1                bpl sprite_save_normal
000238r 1  30 0B                bmi sprite_swap_done
00023Ar 1               sprite_restore_normal:
00023Ar 1  A2 3E                ldx #$3e
00023Cr 1               sprite_restore_copy:
00023Cr 1  BD 00 41             lda VIC_SPRITE_NORMAL,x
00023Fr 1  9D C0 7F             sta VIC_SPRITE,x
000242r 1  CA                   dex
000243r 1  10 F7                bpl sprite_restore_copy
000245r 1               sprite_swap_done:
