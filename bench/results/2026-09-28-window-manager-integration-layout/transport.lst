0003B1r 1  EE EE F7             inc COMMON_GATEWAY+(vertical_row-outline_gateway)
0003B4r 1  AD EE F7             lda COMMON_GATEWAY+(vertical_row-outline_gateway)
0003B7r 1  C9 08                cmp #$08
0003B9r 1  D0 1F                bne vertical_advance_one
0003BBr 1  A9 00                lda #$00
