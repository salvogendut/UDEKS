000000r 1               ; SPDX-License-Identifier: GPL-3.0-or-later
000000r 1               ;
000000r 1               ; Establish the first VIC-IIe graphics surface in physical bank 1.  The copy
000000r 1               ; gateway runs from top common RAM so it can change complete MMU profiles
000000r 1               ; without fetching code from the bank being replaced.
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .export _udeks_vic_graphics_enable
000000r 1                       .export _udeks_vic_graphics_disable
000000r 1                       .export _udeks_vic_pointer_set_x
