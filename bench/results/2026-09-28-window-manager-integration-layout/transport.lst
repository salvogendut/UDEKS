00028Fr 1               page_gateway_end:
00028Fr 1                       .assert page_gateway_end-page_gateway < $f0, error, "VIC page gateway overlaps parameters"
00028Fr 1               
00028Fr 1               ; Each 15-byte record in OUTLINE_BUFFER contains precomputed bitmap addresses:
00028Fr 1               ; top, bottom, horizontal byte count/masks, left/right vertical start/mask,
00028Fr 1               ; vertical pixel count, and the starting scanline within its character row.
00028Fr 1               outline_gateway:
00028Fr 1  A9 00                lda #$00
000291r 1  8D 04 FF             sta MMU_LCR_WORKER_FLAT
000294r 1  8D E7 F7             sta COMMON_GATEWAY+(outline_record-outline_gateway)
000297r 1  AD 7F F3             lda OUTLINE_COUNT
00029Ar 1  8D E8 F7             sta COMMON_GATEWAY+(outline_left-outline_gateway)
00029Dr 1  D0 03                bne outline_next
00029Fr 1  4C 3E F7             jmp COMMON_GATEWAY+(outline_done-outline_gateway)
0002A2r 1               
0002A2r 1               outline_next:
0002A2r 1  AC E7 F7             ldy COMMON_GATEWAY+(outline_record-outline_gateway)
0002A5r 1  B9 84 F3             lda OUTLINE_BUFFER+4,y
0002A8r 1  8D E9 F7             sta COMMON_GATEWAY+(horizontal_count-outline_gateway)
0002ABr 1  B9 85 F3             lda OUTLINE_BUFFER+5,y
0002AEr 1  8D EA F7             sta COMMON_GATEWAY+(horizontal_first-outline_gateway)
0002B1r 1  B9 86 F3             lda OUTLINE_BUFFER+6,y
