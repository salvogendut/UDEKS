0003ECr 1               
0003ECr 1  00           outline_record:          .byte $00
0003EDr 1  00           outline_left:            .byte $00
0003EEr 1  00           horizontal_count:        .byte $00
0003EFr 1  00           horizontal_first:        .byte $00
0003F0r 1  00           horizontal_last:         .byte $00
0003F1r 1  00           horizontal_mask:         .byte $00
0003F2r 1  00           vertical_count:          .byte $00
0003F3r 1  00           vertical_row:            .byte $00
0003F4r 1  00           vertical_mask:           .byte $00
0003F5r 1               outline_gateway_end:
0003F5r 1                       .assert outline_gateway_end-outline_gateway > $100, error, "VIC outline gateway unexpectedly fits one page"
0003F5r 1                       .assert outline_gateway_end-outline_gateway < $200, error, "VIC outline gateway exceeds common workspace"
0003F5r 1               
0003F5r 1                       ; Absolute build symbols consumed by tools/placement_audit.py so the
0003F5r 1                       ; common-RAM budget measures the real gateway copies instead of
0003F5r 1                       ; constants.
0003F5r 1               _udeks_vic_gateway_size_vic = vic_gateway_end-vic_gateway
0003F5r 1               _udeks_vic_gateway_size_sprite = sprite_swap_gateway_end-sprite_swap_gateway
0003F5r 1               _udeks_vic_gateway_size_page = page_gateway_end-page_gateway
0003F5r 1               _udeks_vic_gateway_size_outline = outline_gateway_end-outline_gateway
0003F5r 1               
0003F5r 1               ; The safe C outline-mask expression saves eight CODE bytes with the
0003F5r 1               ; qualified cc65 flags. Keep that saving reserved until a separately qualified
0003F5r 1               ; placement change: boot delivery currently freezes VICSHADOW at $A1E0.
0003F5r 1               ; This is resident padding, not part of any copied common-RAM gateway.
0003F5r 1               outline_mask_placement_reserve:
0003F5r 1  EA EA EA EA          .res 8, $ea
0003F9r 1  EA EA EA EA  
0003FDr 1               ; Scratch-only line/fill storage removes 81 CODE bytes but adds 32 BSS bytes.
0003FDr 1               ; Hold the measured net 49-byte saving here to retain the same shadow/staging
0003FDr 1               ; boundary. Future compositor work may consume it only with placement gates.
0003FDr 1               raster_scratch_placement_reserve:
0003FDr 1  EA EA EA EA          .res 49, $ea
000401r 1  EA EA EA EA  
000405r 1  EA EA EA EA  
00042Er 1               ; Qualified service-local ASM span/pixel routines save 170 CODE + 3 BSS.
00042Er 1               ; Keep all 173 bytes owned here: no change to shadow/staging placement,
00042Er 1               ; common-RAM copies, compiler runtime, or scheduler reservations.
00042Er 1               raster_primitives_placement_reserve:
00042Er 1  EA EA EA EA          .res 173, $ea
000432r 1  EA EA EA EA  
000436r 1  EA EA EA EA  
0004DBr 1               ; Shared raster saved 294 bytes. The UAPP 0.3 explicit completion seam spends
0004DBr 1               ; 158 CODE bytes (no BSS); NMI ownership spends another 71 + 6 call-site
0004DBr 1               ; bytes (no BSS/ZP). Private window-manager C savings recover 221, increasing
0004DBr 1               ; the remaining 59 to 280. All bytes remain owned; shadow placement is frozen.
0004DBr 1               raster_shared_placement_reserve:
0004DBr 1  EA EA EA EA          .res 280, $ea
0004DFr 1  EA EA EA EA  
0004E3r 1  EA EA EA EA  
0005F3r 1                       .export _udeks_vic_gateway_size_vic, _udeks_vic_gateway_size_sprite
0005F3r 1                       .export _udeks_vic_gateway_size_page, _udeks_vic_gateway_size_outline
0005F3r 1               
